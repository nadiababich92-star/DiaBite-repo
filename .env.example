# Copy to .env.local and fill in from Supabase → Project Settings → API keys.
# Use the publishable key (sb_publishable_…), never the service-role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The engine reads the food index from Supabase when these two are set, and
# falls back to the index built into the image when they are not. Both are
# browser-safe: the foods table is public reference data, readable only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Only for `npm run sync:foods`, which writes the table. Supabase → Project
# Settings → Database → Connection string → URI. Never goes near the browser.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Limits on the one public route, POST /agent/ask (server/guard.ts). Every
# value below is the default; set one only to change it. Counters are in
# memory and reset on a restart.
# ASK_IP_10MIN=30        asks per address per 10 minutes
# ASK_IP_DAY=200         asks per address per UTC day
# ASK_SESSION_HOUR=60    asks per conversation per hour
# ASK_DAILY_CEILING=1000 model turns per UTC day, whoever asks
# ALLOWED_ORIGINS=       extra browser origins allowed to read /agent/ask, comma-separated
# ABUSE_GUARD=off        kill switch: skips the three limits above (size caps stay)
